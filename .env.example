# Copy to .env (gitignored). Real environment variables take precedence over this file.

# --- App / migrations / scripts ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pinkass_kiss
# Server-side timeouts on the app's connections (Postgres durations, 0 = none), so a
# write stuck on a lock fails and is rolled back instead of hanging. Defaults: 10s / 60s.
KB_DB_LOCK_TIMEOUT=
KB_DB_STATEMENT_TIMEOUT=

# --- Semantic index (kb.semantic_index.vectorstore) ---
# Any langchain init_embeddings spec ("provider:model"); code default: ollama:nomic-embed-text.
# Every write embeds its files before it commits (all or nothing), so the model must be
# reachable for any write; `fake` = deterministic fake vectors (offline dev, tests).
# The spec names the index namespace: changing it needs `scripts/reindex.py --all`.
# Recommended: an OpenAI-compatible server (TEI or vLLM) via openai:<served model> + base URL.
#   Local (Mac, Metal): brew install text-embeddings-inference &&
#   text-embeddings-router --model-id nomic-ai/nomic-embed-text-v1.5 --port 8090
EMBEDDINGS_MODEL=openai:nomic-ai/nomic-embed-text-v1.5
EMBEDDINGS_BASE_URL=http://localhost:8090/v1
# Only if the server was started with an API key.
EMBEDDINGS_API_KEY=
# Inputs per request (default 32 = TEI's default --max-client-batch-size).
EMBEDDINGS_BATCH_SIZE=
# Must equal the model's output size; migration 0002 creates kb_chunks.embedding as vector(EMBEDDING_DIM).
EMBEDDING_DIM=768

# --- Raw-original storage (kb.storage.blobs) for converted uploads (PDF, ...) ---
# BLOB_BUCKET set -> S3 (boto3; normal AWS_* credential/region env vars apply).
# Unset -> originals aren't kept.
BLOB_BUCKET=
# Leave empty for AWS S3; set for MinIO/R2/GCS-interop, e.g. http://localhost:9000
BLOB_ENDPOINT_URL=
BLOB_PREFIX=kb/
# 1 in production: no BLOB_BUCKET, or a failing bucket check (head_bucket), aborts API startup.
# Unset: no bucket = originals not kept (warning); a failing check is only logged.
BLOB_REQUIRED=
# S3 client tuning (defaults: 5 s connect, 30 s read, 3 attempts in total incl. the first).
BLOB_CONNECT_TIMEOUT=
BLOB_READ_TIMEOUT=
BLOB_MAX_ATTEMPTS=
# Originals are stored per file (<prefix>originals/<file id>), uploaded before the write
# commits and deleted again if it doesn't; scripts/gc.py sweeps what a crash leaves.
# Minimal IAM policy for the app's credentials/role:
#   s3:GetObject, s3:PutObject, s3:DeleteObject on arn:aws:s3:::<bucket>/<prefix>*
#   s3:ListBucket on arn:aws:s3:::<bucket>  (needed for the startup check, and so a
#   missing original is a 404 -- without it S3 answers AccessDenied, which becomes a 502)

# --- Upload limits (POST /ingest; kb.ingest.upload.UploadLimits) -> 413 when exceeded ---
# Empty = default, 0 = no cap. Starlette itself refuses forms with >1000 files or
# >1000 plain fields (each file sends a `paths` field) with a 400, so keep MAX_FILES under
# ~990. Uploads are spooled/mirrored under TMPDIR: on OpenShift see
# deploy/openshift/upload-scratch.yaml, and cap request bodies at the router as well.
# An ingest request lasts as long as converting + embedding the upload: raise the router
# timeout to match (deploy/openshift/route-timeout.yaml).
# Defaults: 500 files, 104857600 bytes (100 MiB) per file, 1073741824 bytes (1 GiB) in total.
KB_UPLOAD_MAX_FILES=
KB_UPLOAD_MAX_FILE_BYTES=
KB_UPLOAD_MAX_TOTAL_BYTES=
# Processes converting PDF/Office files in parallel (kb.ingest.convert). Default: min(4,
# CPUs); 1 = no pool. In a container the CPU count is the node's, not the pod's limit,
# so set this to the pod's CPU limit (each PDF conversion already uses ~1.5 cores, and
# each Docling worker holds its models, hundreds of MB).
KB_INGEST_WORKERS=

# --- Tests (database name must end in _test; tests TRUNCATE its tables) ---
# Matches docker/stack.test.yml (pgvector/pgvector:pg16 image; needs the vector extension)
TEST_DATABASE_URL=postgresql+psycopg://kb:kbtest@localhost:5433/kb_test

# --- LLM test (tests/eval/test_qasper_llm.py); skipped when the chosen provider is unavailable ---
# Provider: anthropic (needs ANTHROPIC_API_KEY, costs money) | ollama (local, free)
#           | openai (any OpenAI-compatible server, e.g. vLLM / vllm-mlx; model defaults to the first one served)
E2E_LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OPENAI_BASE_URL=http://127.0.0.1:8080/v1
# Leave empty for the provider default (claude-opus-5-5 / qwen3-coder:30b). Ollama needs a tool-calling model.
E2E_LLM_MODEL=
E2E_LLM_N=10
# Repetitions per question (each a fresh agent) and parallel worker threads
E2E_LLM_K=5
E2E_LLM_WORKERS=8
E2E_LLM_MIN_ACC=0.3

# --- LLM judge (kb.evaluation.LLMJudge, langchain ChatOpenAI); LLM tests skip without a key ---
OPENAI_API_KEY=
JUDGE_MODEL=gpt-4o-mini
# Optional: any OpenAI-compatible endpoint for the judge. With no key/URL here the judge
# falls back to the local ollama (same model as the agent).
JUDGE_BASE_URL=

# --- Optional: Opik observability for the LLM test (Comet cloud); unset = no tracing ---
OPIK_API_KEY=
OPIK_WORKSPACE=
OPIK_PROJECT_NAME=pinkass-kiss-e2e

# --- Optional: faster HuggingFace downloads for scripts/eval/load_qasper.py ---
HF_TOKEN=

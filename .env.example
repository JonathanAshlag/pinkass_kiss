# Copy to .env (gitignored). Real environment variables take precedence over this file.

# --- App / migrations / scripts ---
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pinkass_kiss

# --- Tests (database name must end in _test; tests TRUNCATE its tables) ---
# Matches docker/stack.test.yml
TEST_DATABASE_URL=postgresql+psycopg://kb:kbtest@localhost:5433/kb_test

# --- LLM test (tests/test_hotpotqa_llm.py); skipped when the chosen provider is unavailable ---
# Provider: anthropic (needs ANTHROPIC_API_KEY, costs money) | ollama (local, free)
HOTPOTQA_LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty for the provider default (claude-opus-5-5 / qwen3-coder:30b). Ollama needs a tool-calling model.
HOTPOTQA_LLM_MODEL=
HOTPOTQA_LLM_N=10
HOTPOTQA_LLM_MIN_ACC=0.6

# --- Optional: faster HuggingFace downloads for scripts/load_hotpotqa.py ---
HF_TOKEN=
